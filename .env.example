# Copy this file to ".env.local" and fill in both values from
# Supabase: Project Settings > API Keys.
# Leave them out to run the app with browser-only storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- AI email drafting (optional, server-only: never prefix with NEXT_PUBLIC_) ---
# Get a key at console.anthropic.com. Leave blank and the AI button says it isn't set up.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# AI_TIMEOUT_MS=45000
# AI_RATE_LIMIT_PER_MINUTE=6
# AI_RATE_LIMIT_PER_DAY=60
# AI_GLOBAL_DAILY_LIMIT=500
# AI_ALLOW_ANONYMOUS=false
