# Copy this file to ".env.local" and fill in both values from
# Supabase: Project Settings > API Keys.
# Leave them out to run the app with browser-only storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- AI email drafting (optional, server-only: never prefix with NEXT_PUBLIC_) ---
# Use ONE of these. Gemini key: aistudio.google.com. Claude key: console.anthropic.com.
# Leave both blank and the AI button says it isn't set up.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# AI_TIMEOUT_MS=45000
# AI_RATE_LIMIT_PER_MINUTE=6
# AI_RATE_LIMIT_PER_DAY=60
# AI_GLOBAL_DAILY_LIMIT=500
# AI_ALLOW_ANONYMOUS=false

# Never put a Supabase "service_role" / secret key or the database password in
# this file or anywhere in this app. Use a separate Supabase project for testing
# and for real use, and keep their values in separate Vercel environments.
# See supabase/README.md.
